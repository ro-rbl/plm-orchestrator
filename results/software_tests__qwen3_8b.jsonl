{"id": "sw-i13", "level": "intensive", "writer": "qwen3:8b", "prompt_version": 1, "tests": ["(lambda t: (t.insert('apple'), t.starts_with('app'))[-1])(Trie()) == ['apple']", "(lambda t: (t.insert('apple'), t.insert('apples'), t.insert('application'), t.starts_with('app'))[-1])(Trie()) == ['apple', 'apples', 'application']", "(lambda t: (t.insert('app'), t.insert('apple'), t.insert('application'), t.starts_with('app'))[-1])(Trie()) == ['app', 'apple', 'application']", "(lambda t: (t.insert('apple'), t.insert('apple'), t.insert('apples'), t.starts_with('app'))[-1])(Trie()) == ['apple', 'apples']", "(lambda t: (t.insert('banana'), t.insert('berry'), t.starts_with('app'))[-1])(Trie()) == []", "(lambda t: (t.insert('apple'), t.insert('app'), t.starts_with('app'))[-1])(Trie()) == ['app', 'apple']", "(lambda t: (t.insert('apple'), t.insert('application'), t.starts_with('appl'))[-1])(Trie()) == ['apple', 'application']", "(lambda t: (t.insert('apple'), t.insert('applesauce'), t.starts_with('app'))[-1])(Trie()) == ['apple', 'applesauce']"], "model": "qwen3:8b", "tokens": 427, "seconds": 42.501549243927, "raw": "```python\n# Test case 1: Inserting a single word and checking starts_with\n(lambda t: (t.insert('apple'), t.starts_with('app'))[-1])(Trie()) == ['apple']\n\n# Test case 2: Inserting multiple words with the same prefix\n(lambda t: (t.insert('apple'), t.insert('apples'), t.insert('application'), t.starts_with('app'))[-1])(Trie()) == ['apple', 'apples', 'application']\n\n# Test case 3: Inserting words with the same prefix but different lengths\n(lambda t: (t.insert('app'), t.insert('apple'), t.insert('application'), t.starts_with('app'))[-1])(Trie()) == ['app', 'apple', 'application']\n\n# Test case 4: Inserting words with the same prefix and duplicates\n(lambda t: (t.insert('apple'), t.insert('apple'), t.insert('apples'), t.starts_with('app'))[-1])(Trie()) == ['apple', 'apples']\n\n# Test case 5: Inserting words with no matching prefix\n(lambda t: (t.insert('banana'), t.insert('berry'), t.starts_with('app'))[-1])(Trie()) == []\n\n# Test case 6: Inserting words with a prefix that is also a word\n(lambda t: (t.insert('apple'), t.insert('app'), t.starts_with('app'))[-1])(Trie()) == ['app', 'apple']\n\n# Test case 7: Inserting words with a prefix that is not a word\n(lambda t: (t.insert('apple'), t.insert('application'), t.starts_with('appl'))[-1])(Trie()) == ['apple', 'application']\n\n# Test case 8: Inserting words with a prefix that is a substring of some words\n(lambda t: (t.insert('apple'), t.insert('applesauce'), t.starts_with('app'))[-1])(Trie()) == ['apple', 'applesauce']\n```", "capped": false}
