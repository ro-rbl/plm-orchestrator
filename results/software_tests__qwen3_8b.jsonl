{"id": "sw-i01", "level": "intensive", "writer": "qwen3:8b", "prompt_version": 1, "tests": ["(lambda c: c.get(1))(LRUCache(1)) == -1", "(lambda c: c.put(1, 1), c.get(1))(LRUCache(1))[-1] == 1", "(lambda c: (c.put(1, 1), c.put(1, 2)), c.get(1))(LRUCache(1))[-1] == 2", "(lambda c: (c.put(1, 1), c.put(2, 2), c.get(1), c.put(3, 3)), c.get(2))(LRUCache(2))[-1] == -1", "(lambda c: (c.put(1, 1), c.get(1), c.get(1)), c.get(1))(LRUCache(1))[-1] == 1", "(lambda c: (c.put(-1, -1), c.get(-1)), c.get(1))(LRUCache(1))[-1] == -1", "(lambda c: (c.put(1, 1), c.put(2, 2), c.put(3, 3), c.get(1), c.put(4, 4)), c.get(2))(LRUCache(3))[-1] == -1", "(lambda c: (c.put(1, 1), c.put(1, 2), c.get(1)), c.get(1))(LRUCache(1))[-1] == 2"], "model": "qwen3:8b", "tokens": 454, "seconds": 43.395281076431274, "raw": "```python\n# Test case 1: Empty cache, get returns -1\n(lambda c: c.get(1))(LRUCache(1)) == -1\n\n# Test case 2: Single element, get returns the value\n(lambda c: c.put(1, 1), c.get(1))(LRUCache(1))[-1] == 1\n\n# Test case 3: Single element, put replaces existing key\n(lambda c: (c.put(1, 1), c.put(1, 2)), c.get(1))(LRUCache(1))[-1] == 2\n\n# Test case 4: Two elements, get one, then put third, evicting the first\n(lambda c: (c.put(1, 1), c.put(2, 2), c.get(1), c.put(3, 3)), c.get(2))(LRUCache(2))[-1] == -1\n\n# Test case 5: Put and get same key, it remains most recently used\n(lambda c: (c.put(1, 1), c.get(1), c.get(1)), c.get(1))(LRUCache(1))[-1] == 1\n\n# Test case 6: Negative key and value\n(lambda c: (c.put(-1, -1), c.get(-1)), c.get(1))(LRUCache(1))[-1] == -1\n\n# Test case 7: Put multiple keys, then get one, then put another, evicting the oldest\n(lambda c: (c.put(1, 1), c.put(2, 2), c.put(3, 3), c.get(1), c.put(4, 4)), c.get(2))(LRUCache(3))[-1] == -1\n\n# Test case 8: Put and get with duplicate keys (should return the latest value)\n(lambda c: (c.put(1, 1), c.put(1, 2), c.get(1)), c.get(1))(LRUCache(1))[-1] == 2\n```", "capped": false}
